# ==============================================================================
# ContractIQ — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the server:
# cp .env.example .env (or copy .env.example server/.env)
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Neon / Supabase / Local PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If left empty, ContractIQ boots with high-performance in-memory pg-mem fallback.
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# JWT Authentication & Session Security
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_contractiq_jwt_key_2026_production_grade_security
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Indian Online Payments & Webhook Verification)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_key

# ------------------------------------------------------------------------------
# AI Provider Configuration for Contract Intelligence & Legal Analysis
# Supported: rule_based (built-in semantic analysis), openai, anthropic, gemini
# ------------------------------------------------------------------------------
AI_PROVIDER=rule_based
AI_API_KEY=your_ai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Real-Time Video/Audio Consultation Credentials (Agora / WebRTC)
# ------------------------------------------------------------------------------
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ------------------------------------------------------------------------------
# Transactional Email & Notifications (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@contractiq.law
EMAIL_PASS=your_email_app_password
EMAIL_FROM="ContractIQ Legal Platform <no-reply@contractiq.law>"

# ------------------------------------------------------------------------------
# Platform Fee & Commission Policy
# ------------------------------------------------------------------------------
DEFAULT_PLATFORM_COMMISSION_PERCENTAGE=15
GST_PERCENTAGE=18

# ------------------------------------------------------------------------------
# Initial Super Administrator Credentials
# ------------------------------------------------------------------------------
ADMIN_NAME="ContractIQ Lead Administrator"
ADMIN_EMAIL=admin@contractiq.law
ADMIN_PASSWORD=Admin@12345
ADMIN_ID=ADM-CONTRACTIQ-001
