# ==============================================================================
# ContractIQ — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
# cp .env.example .env (or copy .env.example server/.env and client/.env)
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase Core Configuration (Database, Auth, Storage, and Realtime)
# Project URL: https://vdwhesbuqqdvlbmotjmz.supabase.co
# ------------------------------------------------------------------------------
# Frontend Environment Variables (.env / client/.env)
VITE_SUPABASE_URL=https://vdwhesbuqqdvlbmotjmz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_API_URL=/api

# Backend Environment Variables (server/.env)
SUPABASE_URL=https://vdwhesbuqqdvlbmotjmz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Neon PostgreSQL Database Configuration (Production Serverless Pooler - Port 5432)
# Format: postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
# Obtain from Neon Console (https://console.neon.tech) -> Dashboard -> Connection Details
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:[YOUR-NEON-PASSWORD]@ep-contractiq-production-pooler.us-east-1.aws.neon.tech/contractiq?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:[YOUR-NEON-PASSWORD]@ep-contractiq-production-pooler.us-east-1.aws.neon.tech/contractiq?sslmode=require

# ------------------------------------------------------------------------------
# Optional Supabase Database Connection (Fallback / Multi-Cloud)
# ------------------------------------------------------------------------------
# SUPABASE_DATABASE_URL=postgresql://postgres.vdwhesbuqqdvlbmotjmz:[YOUR-DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require


# ------------------------------------------------------------------------------
# Supabase Storage Buckets
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_CONTRACTS_BUCKET=contract-documents
SUPABASE_STORAGE_CASES_BUCKET=case-documents
SUPABASE_STORAGE_LAWYER_DOCS_BUCKET=lawyer-documents
SUPABASE_STORAGE_PROFILES_BUCKET=user-profiles
SUPABASE_STORAGE_SIGNED_CONTRACTS_BUCKET=signed-contracts

# ------------------------------------------------------------------------------
# JWT Authentication & Session Security (ContractIQ internal fallback)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_contractiq_jwt_key_2026_production_grade_security
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Indian Online Payments & Webhook Verification)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_key

# ------------------------------------------------------------------------------
# AI Provider Configuration for Contract Intelligence & Legal Analysis
# Supported: rule_based (built-in semantic legal analysis), openai, anthropic, gemini
# ------------------------------------------------------------------------------
AI_PROVIDER=rule_based
AI_API_KEY=your_ai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Real-Time Video/Audio Consultation Credentials (Agora / WebRTC)
# ------------------------------------------------------------------------------
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ------------------------------------------------------------------------------
# Transactional Email & Notifications (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@contractiq.law
EMAIL_PASS=your_email_app_password
EMAIL_FROM="ContractIQ Legal Platform <no-reply@contractiq.law>"

# ------------------------------------------------------------------------------
# Platform Fee & Commission Policy
# ------------------------------------------------------------------------------
DEFAULT_PLATFORM_COMMISSION_PERCENTAGE=15
GST_PERCENTAGE=18

# ------------------------------------------------------------------------------
# Initial Super Administrator Credentials
# ------------------------------------------------------------------------------
ADMIN_NAME="ContractIQ Lead Administrator"
ADMIN_EMAIL=admin@contractiq.law
ADMIN_PASSWORD=Admin@12345
ADMIN_ID=ADM-CONTRACTIQ-001
