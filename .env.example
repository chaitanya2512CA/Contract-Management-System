# ==============================================================================
# JurisFlow — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
# cp .env.example .env (or copy .env.example server/.env and client/.env)
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# Neon PostgreSQL Database Configuration (Production Serverless Pooler - Port 5432)
# Format: postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
# Obtain from Neon Console (https://console.neon.tech) -> Dashboard -> Connection Details
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:[YOUR-NEON-PASSWORD]@ep-sweet-block-bbr0s9mf-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://neondb_owner:[YOUR-NEON-PASSWORD]@ep-sweet-block-bbr0s9mf-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://neondb_owner:[YOUR-NEON-PASSWORD]@ep-sweet-block-bbr0s9mf.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_PRISMA_URL=postgresql://neondb_owner:[YOUR-NEON-PASSWORD]@ep-sweet-block-bbr0s9mf-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require

# Individual Connection Parameters (Vercel Postgres standard)
PGHOST=ep-sweet-block-bbr0s9mf-pooler.c-15.us-east-1.aws.neon.tech
PGUSER=neondb_owner
PGPASSWORD=[YOUR-NEON-PASSWORD]
PGDATABASE=neondb
NEON_PROJECT_ID=proud-grass-64741018

# ------------------------------------------------------------------------------
# JWT Authentication & Session Security
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_contractiq_jwt_key_2026_production_grade_security
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Indian Online Payments & Webhook Verification)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_key

# ------------------------------------------------------------------------------
# OpenAI / Anthropic AI Services (Contract Extraction & Risk Analysis)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder_for_openai_api_key_contracts
ANTHROPIC_API_KEY=sk-ant-placeholder_for_anthropic_api_key

# ------------------------------------------------------------------------------
# Email Notifications & Service Alerts (Nodemailer / SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@jurisflow.com
SMTP_PASS=app_password_here
EMAIL_FROM="JurisFlow Legal Platform <noreply@jurisflow.com>"
